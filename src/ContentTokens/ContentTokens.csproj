<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ContentTokens</PackageId>
    <Version>1.0.0</Version>
    <Authors>Alex Boesen</Authors>
    <Company>Hangsolow</Company>
    <Description>Dynamic placeholders for Optimizely CMS — write {{TokenName}} in any text field and let editors define reusable, multilingual content tokens.</Description>
    <PackageTags>Optimizely;CMS;Tokens;Placeholders</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Hangsolow/ContentTokens</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.UI" Version="12.34.2" />
    <PackageReference Include="EPiServer.CMS.TinyMce" Version="5.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <_ModuleZipPath>$(MSBuildProjectDirectory)\..\..\build\ContentTokens.zip</_ModuleZipPath>
    <_ModuleStagingPath>$(MSBuildProjectDirectory)\obj\module-staging\ContentTokens</_ModuleStagingPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- module.config is assembled into the ZIP at build time, not embedded in the DLL -->
    <None Include="module.config" />
    <None Include="ClientResources\**\*.*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Pack the module ZIP into contentFiles so consumers get it via NuGet -->
  <ItemGroup>
    <None Include="$(_ModuleZipPath)"
          Pack="true"
          PackagePath="contentFiles\any\any\modules\_protected\ContentTokens\ContentTokens.zip"
          Condition="Exists('$(_ModuleZipPath)')" />
    <None Include="$(MSBuildProjectDirectory)\..\..\build\ContentTokens.targets"
          Pack="true"
          PackagePath="build\ContentTokens.targets" />
  </ItemGroup>

  <!--
    Assemble the protected module structure and zip it before building or packing.
    Files stay in their source locations; the ZIP is a build artifact (gitignored).
  -->
  <Target Name="CreateModuleZip" BeforeTargets="Build;Pack">
    <MakeDir Directories="$(_ModuleStagingPath)" />

    <ItemGroup>
      <_ClientResourceFiles Include="$(MSBuildProjectDirectory)\ClientResources\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(_ClientResourceFiles)"
          DestinationFiles="@(_ClientResourceFiles -> '$(_ModuleStagingPath)\ClientResources\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)\module.config"
          DestinationFolder="$(_ModuleStagingPath)"
          SkipUnchangedFiles="true" />

    <ZipDirectory SourceDirectory="$(_ModuleStagingPath)"
                  DestinationFile="$(_ModuleZipPath)"
                  Overwrite="true" />
  </Target>

</Project>
